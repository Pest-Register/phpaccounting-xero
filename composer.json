{
    "name": "pest-register/php-accounting-xero",
    "description": "Xero package for PHP Accounting",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Max",
            "email": "max@pestregister.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-simplexml": "*",
        "guzzlehttp/guzzle": "^7.10",
        "calcinai/xero-php": "^2.0.1",
        "fakerphp/faker": "^1.9.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "vlucas/phpdotenv": "^5.0",
        "nesbot/carbon": "^3.8"
    },
    "autoload": {
        "psr-4": { "PHPAccounting\\Xero\\" : "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true
}
